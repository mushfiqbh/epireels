# Base URL for the NestJS API, embedded in the client bundle.
# Use the LAN IP of your dev machine when running on a physical device,
# e.g. http://192.168.1.42:4000. The Android emulator can use 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional: scheme used by `expo start --tunnel` / deep-link helpers.
# EXPO_PUBLIC_APP_SCHEME=acme
