{
  "name": "@epireels/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Expo Router React Native app. Node 24.19.",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo prebuild --no-install",
    "start": "expo start",
    "lint": "echo \"(mobile) configure eslint when you grow past one screen\" && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "echo \"(mobile) add jest-expo when needed\" && exit 0",
    "clean": "rm -rf .expo .expo-shared dist ios android *.tsbuildinfo"
  },
  "dependencies": {
    "@epireels/types": "workspace:*",
    "expo": "~53.0.0",
    "expo-constants": "~17.1.8",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.11",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.0.0",
    "typescript": "~5.8.3"
  }
}
