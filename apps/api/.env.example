# HTTP port for the NestJS server.
PORT=4000

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/epireels?schema=public"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/epireels?schema=public"

# Storage driver: 'local' (filesystem), 's3' (not implemented in starter).
STORAGE_DRIVER=local
# Only used when STORAGE_DRIVER=local. Resolved relative to process.cwd().
STORAGE_LOCAL_PATH=../../storage/development

# System binaries used by the asynchronous video processor.
#
# Leave blank to let the API auto-resolve `ffmpeg(.exe)` / `ffprobe(.exe)`:
#   1. The `PATH`
#   2. Common Windows install locations
#      (`C:\Program Files\ffmpeg\bin`, `C:\ProgramData\chocolatey\bin`,
#       `%LOCALAPPDATA%\Microsoft\WinGet\Packages\...`)
#   3. Falls back to spawning the bare command, which surfaces
#      `spawn ffmpeg ENOENT` so the failure is obvious.
#
# Install options:
#   Windows (winget) : winget install Gyan.FFmpeg
#   Windows (choco)  : choco install ffmpeg
#   macOS            : brew install ffmpeg
#   Debian / Ubuntu  : sudo apt-get install ffmpeg
#
# Verify with `pnpm --filter @epireels/api ffmpeg:check`.
FFMPEG_PATH=
FFPROBE_PATH=

# Comma-separated origins allowed to call the API (CORS).
WEB_ORIGIN=http://localhost:3000,http://localhost:8081

# Optional: surfaced in /api/v1/health.
APP_VERSION=0.1.0

# ─── Auth / Session ──────────────────────────────────────────────────────────
#
# JWT_SECRET must be a random string of at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In production this MUST be unique per deployment; rotating the value
# invalidates every issued access token.
JWT_SECRET=replace-me-with-a-48-byte-random-string-aaaaaaaaaaaaaaaaaaaa

# Access-JWT lifetime. Format: <number><s|m|h|d>  (default: 15m)
JWT_EXPIRES_IN=15m

# Refresh-token + CSRF-cookie lifetime. (default: 7d)
REFRESH_EXPIRES_IN=7d

# Cookie security flags. `secure: true` is enforced automatically when
# NODE_ENV=production regardless of this setting; flip it on early if
# you're serving the API over HTTPS in a dev environment.
COOKIE_SECURE=false

# Optional cookie domain (e.g. ".example.com"). Leave blank for the host
# default so the cookie is scoped to the API's own hostname.
COOKIE_DOMAIN=
